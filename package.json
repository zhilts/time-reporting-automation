{
  "name": "time-reporting-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:entries": "node ./src/cli.ts check-entries",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",

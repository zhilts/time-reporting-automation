{
  "privacy": {
    "contains_sensitive_mappings": true
  },
  "scope": {
    "include_projects": [
      "External Project Name"
    ]
  },
  "toggl_api": {
    "api_token": "YOUR_TOGGL_API_TOKEN"
  },
  "parser_factory": {
    "project_parser_map": {
      "External Project Name": "ticket-id-project"
    },
    "project_aliases": {
      "Alternate External Name": "External Project Name"
    }
  },
  "project_code_map": {
    "External Project Name": "INTERNAL_CODE_HERE"
  },
  "activity_description_tags": {
    "RealCategoryTagA": "Real Target Description A",
    "RealCategoryTagB": "Real Target Description B"
  },
  "meeting_bucket_tags": {
    "RealMeetingTagA": "Real Meeting Bucket A",
    "RealMeetingTagB": "Real Meeting Bucket B"
  },
  "entry_classification": {
    "meeting_description_patterns": ["standup", "sync", "meeting", "daily"],
    "meeting_description_mode": "preserve",
    "ticket_id_patterns": ["^ABC-\\d+$", "^XYZ-\\d+$"]
  },
  "aggregation": {
    "mode": "date_range"
  },
  "upload": {
    "target_page_url": "https://internal.example.local/time-reports",
    "standard_minutes_per_workday": 480,
    "working_days": [1, 2, 3, 4, 5],
    "holidays": [],
    "project_option_labels": {
      "INTERNAL_CODE_HERE": "UI Project Label"
    },
    "default_task_by_project": {
      "ANOTHER_INTERNAL_CODE": "Interview"
    },
    "task_by_activity_code": {
      "INTERNAL_CODE_HERE": {
        "Real Target Description A": "UI Task Label A",
        "Real Target Description B": "UI Task Label B",
        "Communication": "Communication"
      }
    },
    "task_matchers_by_project": {
      "ANOTHER_INTERNAL_CODE": [
        {
          "match_type": "prefix",
          "pattern": "PPR",
          "task_label": "Performance Review"
        }
      ]
    }
  },
  "browser_launch": {
    "enabled": true,
    "channel": "chrome",
    "headless": false,
    "user_data_dir": "./.browser-profile",
    "args": []
  }
}

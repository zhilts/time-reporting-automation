{
  "toggl": {
    "required_fields": ["id", "start", "duration_minutes", "description"],
    "field_aliases": {
      "id": ["id", "ID"],
      "start": ["start", "Start", "Start date"],
      "duration_minutes": ["duration_minutes", "Duration minutes", "Duration"],
      "client": ["client", "Client"],
      "project": ["project", "Project"],
      "task": ["task", "Task"],
      "tags": ["tags", "Tags"],
      "description": ["description", "Description"]
    },
    "tags_separator": ","
  },
  "parser_factory": {
    "default_parser": "default",
    "project_parser_map": {
      "Project Alpha": "ticket-id-project"
    },
    "project_aliases": {
      "ProjectAlpha": "Project Alpha",
      "Alpha": "Project Alpha"
    }
  },
  "project_code_map": {
    "Project Alpha": "INTERNAL_PROJECT_CODE"
  },
  "activity_description_tags": {
    "CategoryA": "CategoryA",
    "CategoryB": "CategoryB",
    "CategoryC": "CategoryC"
  },
  "meeting_bucket_tags": {
    "MeetingTypeA": "Meeting Bucket A",
    "MeetingTypeB": "Meeting Bucket B",
    "MeetingTypeC": "Meeting Bucket C"
  },
  "entry_classification": {
    "meeting_task_names": ["Meeting"],
    "meeting_description_patterns": ["standup", "sync", "meeting", "daily", "1-1", "1:1", "interview"],
    "meeting_description_mode": "bucket",
    "ticket_id_patterns": ["^[A-Z]+-\\d+$"],
    "ticket_id_sources": ["task", "description"]
  },
  "rounding": {
    "increment_minutes": 30,
    "policy": "nearest"
  },
  "upload": {
    "target_page_url": "https://internal.example.local/time-reports",
    "project_option_labels": {
      "INTERNAL_PROJECT_CODE": "INTERNAL_PROJECT_CODE"
    },
    "default_task_by_project": {
      "INTERNAL_PROJECT_CODE": "CategoryA"
    },
    "task_by_activity_code": {
      "INTERNAL_PROJECT_CODE": {
        "CategoryA": "CategoryA",
        "CategoryB": "CategoryB",
        "CategoryC": "CategoryC"
      }
    },
    "task_matchers_by_project": {
      "INTERNAL_PROJECT_CODE": [
        {
          "match_type": "prefix",
          "pattern": "Review",
          "task_label": "CategoryB"
        }
      ]
    }
  },
  "rules": {
    "unknown_project_code": "needs_review",
    "unknown_activity_tag": "needs_review",
    "unknown_meeting_bucket": "needs_review",
    "unknown_parser": "needs_review"
  }
}
